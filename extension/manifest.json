{
  "manifest_version": 3,
  "name": "Munshi Desk",
  "description": "Voice-assisted form entry and citizen read-back for civic service desktops.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Open Munshi Desk for this tab" },
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "background": { "service_worker": "worker.js" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "permissions.html",
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+M", "mac": "Alt+M" } } }
}
